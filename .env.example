# Copy to a file outside the repository and pass it with `node --env-file=...`.
# These are settings, not secrets: app credentials and sign-ins are entered on
# the connect page and stored in SOCIAL_POSTER_DATA_DIR.

# The address your browser uses to reach the connect page. The sign-in callback
# URLs are built from it, so it must match what you register with X and LinkedIn.
PUBLIC_URL=http://127.0.0.1:8945

# Where credentials.json and history.jsonl are kept (owner-only files).
SOCIAL_POSTER_DATA_DIR=./data

# PORT=8945
# HOST=127.0.0.1
